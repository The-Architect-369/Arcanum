{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/trusted-update-manifest.v1.json",
  "title": "Arcanum Trusted Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType",
    "package",
    "artifact",
    "build",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "manifestType": {
      "const": "arcanum-own-package-update"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "versionCode",
        "versionName"
      ],
      "properties": {
        "applicationId": {
          "const": "org.arcanum.nativehost"
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "versionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "sizeBytes",
        "publisherSignerSha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "publisherSignerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceCommit",
        "promotionBranch",
        "promotionCommit",
        "channel"
      ],
      "properties": {
        "repository": {
          "const": "The-Architect-369/Arcanum"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "promotionBranch": {
          "const": "main"
        },
        "promotionCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "channel": {
          "const": "pre-genesis"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minSdk",
        "targetSdk",
        "abis",
        "dataContracts",
        "companion"
      ],
      "properties": {
        "minSdk": {
          "type": "integer",
          "minimum": 1
        },
        "targetSdk": {
          "type": "integer",
          "minimum": 1
        },
        "abis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "dataContracts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "companion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brokerContract",
            "operatorContract",
            "nativeOperations"
          ],
          "properties": {
            "brokerContract": {
              "const": "arcanum-termux-broker/1.1"
            },
            "operatorContract": {
              "const": "ce-w04-a13.5/five-op-v1"
            },
            "nativeOperations": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                {
                  "const": "probe_workspace"
                },
                {
                  "const": "pair_native_client"
                },
                {
                  "const": "start_broker"
                },
                {
                  "const": "stop_broker"
                },
                {
                  "const": "verify_workspace"
                }
              ],
              "items": false
            }
          }
        }
      }
    }
  }
}
