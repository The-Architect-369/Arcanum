{
  "$schema": "./android-runtime-bridge.schema.json",
  "bridgeContractId": "android-runtime-bridge",
  "schemaVersion": "0.1.0",
  "status": "implementation-candidate",
  "runtimeCrate": "runtime/arcanum-runtime",
  "bridgeCrate": "runtime/arcanum-android-bridge",
  "ffiCrate": "runtime/arcanum-android-jni",
  "androidHost": "apps/android",
  "abi": {
    "kind": "jni",
    "version": 1,
    "library": "arcanum_android_jni",
