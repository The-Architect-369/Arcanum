{
  "vectorSet": "arcnet-spatial-architecture-falsification",
  "version": "0.2.0",
  "registry": "./arcnet-spatial-architecture.v0.2.json",
  "tolerance": 1e-12,
  "expectations": {
    "F11": {
      "basisDecimal": {
        "bQ": [1.0, 0.0],
        "bR": [0.5, 0.8660254037844386]
      },
      "neighborOffsets": [
        [1, 0],
        [-1, 0],
        [0, 1],
        [0, -1],
        [1, -1],
        [-1, 1]
      ],
      "expectedNeighborDistance": 1.0,
      "sampleAddresses": [
        [0, 0],
        [2, -1],
        [-3, 2]
      ]
    },
    "F12": {
      "shellCounts": [
        {"n": 1, "count": 6},
        {"n": 2, "count": 12},
        {"n": 3, "count": 18}
      ],
      "cumulativeWindowCounts": [
        {"n": 0, "count": 1},
        {"n": 1, "count": 7},
        {"n": 2, "count": 19},
        {"n": 3, "count": 37}
      ],
      "finiteWindows": {
        "seed-7": 7,
        "flower-19": 19
      }
    },
    "F13": {
      "testMaxShell": 3,
      "expectedDistinctAddressCount": 37
    },
    "F14": {
      "formula": "L(x,y)=(x,y,0)",
      "testMaxShell": 3,
      "expectedZ": 0.0,
      "preservesPlanarDistance": true,
      "samplePairs": [
        {
          "a": [0, 0],
          "b": [1, 0]
        },
        {
          "a": [2, -1],
          "b": [-1, 2]
        },
        {
          "a": [-3, 2],
          "b": [1, -2]
        }
      ]
    },
    "F15": {
      "canonicalAddress": [2, -1],
      "orientationContexts": [
        "Arcanum-facing",
        "Architect-facing",
        "AERARIUM-facing",
        "registered-context"
      ],
      "expectedCanonicalAddress": [2, -1],
      "canonicalAddressMutationAllowed": false
    },
    "F16": {
      "authorityEffect": "none",
      "forbiddenEffects": [
        "identity",
        "identity-classification",
        "capability",
        "permission",
        "authority",
        "governance-weight",
        "recognition",
        "recognition-state",
        "readiness",
        "worth",
        "score",
        "economic-entitlement",
        "protocol-finality"
      ]
    },
    "F17": {
      "requiredCorrespondenceFields": [
        "sourceRef",
        "provenance",
        "status"
      ],
      "coordinatesSelfAuthenticateMeaning": false
    },
    "F18": {
      "geometryFreeEquivalentRequired": true,
      "operationalStatePreserved": true,
      "authorityMeaningPreserved": true
    },
    "F19": {
      "graphTypes": [
        "semantic-correspondence",
        "execution",
        "physical"
      ],
      "adapterCanInventPhysicalConnectivity": false,
      "logicalAdjacencyCreatesExecutionPath": false,
      "logicalAdjacencyCreatesPhysicalEdge": false,
      "absentPhysicalLogicalEdgePolicy": "route-or-report-unmapped"
    },
    "F20": {
      "flowerDerivedPreferredResearchHypothesis": true,
      "physicalOptimalityClaim": false,
      "requiresEmpiricalEvidence": true,
      "requiresSeparateRatification": true,
      "manufacturingMandate": false
    }
  },
  "negativeCases": [
    {
      "id": "flower-neighbor-spacing-mutated",
      "mutation": "flowerLattice.nearestNeighborSpacing=2",
      "expectedFailure": "F11"
    },
    {
      "id": "flower-window-count-mutated",
      "mutation": "flowerLattice.initialWindowCounts=[1,7,18,37]",
      "expectedFailure": "F12"
    },
    {
      "id": "orientation-mutates-canonical-address",
      "mutation": "orientationFrames.canonicalAddressMutationAllowed=true",
      "expectedFailure": "F15"
    },
    {
      "id": "correspondence-gains-authority",
      "mutation": "correspondenceProfiles.authorityEffect=grant",
      "expectedFailure": "F16"
    },
    {
      "id": "correspondence-provenance-removed",
      "mutation": "correspondenceProfiles.requiredFields excludes provenance",
      "expectedFailure": "F17"
    },
    {
      "id": "geometry-free-equivalent-disabled",
      "mutation": "geometryFreeEquivalent.required=false",
      "expectedFailure": "F18"
    },
    {
      "id": "physical-connectivity-invented",
      "mutation": "topology.adapterCanInventPhysicalConnectivity=true",
      "expectedFailure": "F19"
    },
    {
      "id": "physical-optimality-asserted",
      "mutation": "hardwareHypothesis.physicalOptimalityClaim=true",
      "expectedFailure": "F20"
    }
  ]
}
