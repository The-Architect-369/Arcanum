    "allowed_language": [
      "relative phase",
      "phase difference",
      "current pair of coordinates"
    ],
    "forbidden_language": [
      "aligned",
      "misaligned",
      "ahead",
      "behind",
      "late",
      "early",
      "good timing",
      "bad timing",
      "optimal window"
    ],
    "score": null
  },
  "event_semantics": {
