      "changes": ["tempus.normalized_phase", "captured_at"],
      "must_not_change": ["vitae.grade_index", "vitae.grade_section_index", "recognition", "authority"]
    },
    "TempusWrap": {
      "condition": "tempus phase crosses 1 -> 0",
      "meaning": "cycle recurrence in the selected Tempus projection",
      "must_not_change": ["vitae coordinate", "recognition", "authority"],
      "completion_claim": false
    },
    "VitaeMove": {
      "trigger": "explicit participant control or recorded practice/navigation event only",
      "changes": ["vitae.grade_section_index"],
      "must_not_change": ["historical Tempus samples"],
      "automatic": false
    },
    "CaptureSample": {
      "stores": ["tempus coordinate", "vitae coordinate", "capture time"],
      "interpretation": null,
      "recognition_effect": "none"
    }
  },
  "pause_and_rest_test": {
    "initial": "fix Vitae at any grade_section_index",
    "operation": "allow Tempus phase to advance for one or more complete selected cycles",
    "required_result": "Vitae remains at the same coordinate while the product-space point traces a closed Tempus-direction loop",
    "forbidden_result": "debt, lateness, missed lesson, automatic catch-up, loss of standing, recognition change",
    "status": "required renderer invariant"
