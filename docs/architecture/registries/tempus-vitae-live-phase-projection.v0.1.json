      "interpretation": null,
      "recognition_effect": "none",
      "authority_effect": "none"
    }
  },
  "default_tempus_cycle": {
    "id": "civil_day",
    "status": "presentation-safe factual cycle derived from device-local clock",
    "formula": "seconds_since_local_midnight / 86400",
    "meaning": "where the local civil day currently is",
    "not_claimed": [
      "solar longitude",
      "lunar phase",
      "zodiac position",
      "planetary hour",
      "ritual window",
      "readiness"
    ],
    "reason_for_default": "It can be derived from capturedAt and local timezone without inventing astronomical or symbolic data that the prototype does not actually compute."
  },
  "vitae_cycle": {
    "sections_per_grade": 360,
    "classes_per_grade": 10,
    "sections_per_class": 36,
    "normalized_phase": "(grade_section_index - 1) / 360",
    "class_index": "floor((grade_section_index - 1) / 36) + 1",
    "tree_station_order": [
      "malkuth",
      "yesod",
      "hod",
      "netzach",
      "tiferet",
      "gevurah",
      "chesed",
      "binah",
      "chokhmah",
      "keter"
    ],
    "posture": "navigation coordinate only; phase does not imply readiness or completion"
  },
  "product_phase_space": {
    "mathematical_model": "S1 x S1",
    "common_visualization": "torus",
    "u": "2*pi*tempus.normalized_phase",
    "v": "2*pi*vitae.normalized_grade_phase",
    "torus_embedding_for_renderer": {
      "major_radius": 2.2,
      "minor_radius": 0.8,
      "x": "(R + r*cos(v))*cos(u)",
      "y": "(R + r*cos(v))*sin(u)",
      "z": "r*sin(v)"
    },
    "display_projection": "isometric-like 2D projection of the 3D embedding",
    "topological_note": "The phase square with opposite edges identified is the same product topology and must remain available as a geometry-light equivalent."
  },
  "relative_phase": {
    "formula": "delta = ((tempus_phase - vitae_phase + 0.5) mod 1) - 0.5",
