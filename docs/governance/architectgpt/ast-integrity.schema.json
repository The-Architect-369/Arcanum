{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/ast-dependency-integrity-report.v1.json",
  "title": "Arcanum AST and Dependency Integrity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "repository",
    "commit",
    "project",
    "status",
    "source_file_count",
    "failure_count",
    "findings",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "ast_dependency_integrity_report"},
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail"]},
    "source_file_count": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_errors",
        "unresolved_local_imports",
        "undeclared_dependencies",
        "dependency_cycles"
      ],
      "properties": {
        "compiler_errors": {"type": "array", "items": {"type": "string"}},
        "unresolved_local_imports": {"type": "array", "items": {"type": "object"}},
        "undeclared_dependencies": {"type": "array", "items": {"type": "object"}},
        "dependency_cycles": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"}
          }
        }
      }
    },
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
