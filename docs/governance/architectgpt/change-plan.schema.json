{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/change-plan.v1.json",
  "title": "Arcanum Repository Change Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "repository",
    "base_commit",
    "target_branch",
    "permission_class",
    "summary",
    "changes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "repository_change_plan"},
    "repository": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"const": "mobile"},
    "permission_class": {"enum": ["W1", "W2", "W3", "C1"]},
    "summary": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "path", "purpose"],
        "properties": {
          "action": {"enum": ["create", "update", "delete", "rename"]},
          "path": {"type": "string", "minLength": 1},
          "from_path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"action": {"const": "rename"}},
              "required": ["action"]
            },
            "then": {"required": ["from_path"]},
            "else": {"not": {"required": ["from_path"]}}
          }
        ]
      }
    }
  }
}
