{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/architectgpt/post-merge-closure.schema.json",
  "title": "Architect GPT Post-Merge Closure Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "timestamp",
    "repository",
    "wave",
    "pull_request_number",
    "merge_commit",
    "production",
    "branches",
    "checks",
    "effect",
    "request_sha256",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "post_merge_closure_attestation" },
    "timestamp": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "const": "https://github.com/The-Architect-369/Arcanum.git" },
    "wave": { "type": "string", "pattern": "^wave-[a-z0-9-]+$" },
    "pull_request_number": { "type": "integer", "minimum": 1 },
    "merge_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "deployment_id", "state", "commit"],
      "properties": {
        "provider": { "const": "vercel" },
        "deployment_id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "state": { "const": "READY" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "integration", "main", "mobile_before", "mobile_after"],
      "properties": {
        "base": { "const": "main" },
        "integration": { "const": "mobile" },
        "main": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mobile_before": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mobile_after": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean_checkout", "main_exact", "production_exact", "mobile_lease", "fast_forward", "remote_sync"],
      "properties": {
        "clean_checkout": { "const": "pass" },
        "main_exact": { "const": "pass" },
        "production_exact": { "const": "pass" },
        "mobile_lease": { "const": "pass" },
        "fast_forward": { "const": "pass" },
        "remote_sync": { "const": "pass" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "performed", "result"],
      "properties": {
        "requested": { "const": "origin_mobile_fast_forward" },
        "performed": { "type": "boolean" },
        "result": { "enum": ["fast_forwarded", "already_synchronized", "dry_run"] }
      }
    },
    "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "closed" }
  }
}
