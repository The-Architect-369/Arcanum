{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/candidate-publisher.v1.json",
  "title": "Arcanum Candidate Ref Publication Records",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/attestation"}
  ],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "repository", "target_branch",
        "expected_ref", "expected_old_commit", "candidate_commit_sha",
        "candidate_attestation_sha256", "permission_class", "authorization",
        "summary", "request_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "candidate_ref_publication_request"},
        "repository": {"type": "string", "minLength": 1},
        "target_branch": {"const": "mobile"},
        "expected_ref": {"const": "refs/heads/mobile"},
        "expected_old_commit": {"$ref": "#/$defs/sha40"},
        "candidate_commit_sha": {"$ref": "#/$defs/sha40"},
        "candidate_attestation_sha256": {"$ref": "#/$defs/sha64"},
        "permission_class": {"const": "W2"},
        "authorization": {"const": "explicit_human_request"},
        "summary": {"type": "string", "minLength": 1},
        "request_sha256": {"$ref": "#/$defs/sha64"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "repository", "target_branch",
        "ref", "expected_old_commit", "candidate_commit_sha",
        "candidate_attestation_sha256", "publication_request_sha256",
        "mode", "status", "local_ref_updated", "remote_ref_updated",
        "push_performed", "merge_performed", "deploy_performed",
        "authority", "attestation_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "candidate_ref_publication_attestation"},
        "repository": {"type": "string", "minLength": 1},
        "target_branch": {"const": "mobile"},
        "ref": {"const": "refs/heads/mobile"},
        "expected_old_commit": {"$ref": "#/$defs/sha40"},
        "candidate_commit_sha": {"$ref": "#/$defs/sha40"},
        "candidate_attestation_sha256": {"$ref": "#/$defs/sha64"},
        "publication_request_sha256": {"$ref": "#/$defs/sha64"},
        "mode": {"enum": ["dry_run", "apply"]},
        "status": {"enum": ["ready", "applied"]},
        "local_ref_updated": {"type": "boolean"},
        "remote_ref_updated": {"const": false},
        "push_performed": {"const": false},
        "merge_performed": {"const": false},
        "deploy_performed": {"const": false},
        "authority": {"enum": ["evidentiary_only", "local_repository_write_only"]},
        "attestation_sha256": {"$ref": "#/$defs/sha64"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "dry_run"}}},
          "then": {
            "properties": {
              "status": {"const": "ready"},
              "local_ref_updated": {"const": false},
              "authority": {"const": "evidentiary_only"}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "apply"}}},
          "then": {
            "properties": {
              "status": {"const": "applied"},
              "local_ref_updated": {"const": true},
              "authority": {"const": "local_repository_write_only"}
            }
          }
        }
      ]
    }
  }
}
