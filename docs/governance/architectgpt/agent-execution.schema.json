{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/architectgpt/agent-execution.schema.json",
  "title": "Architect GPT Guarded Read-Only Agent Execution Records",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/attestation"}
  ],
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "paths"],
      "properties": {
        "tool": {"enum": ["repository.read", "repository.search"]},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "query": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"tool": {"const": "repository.search"}}},
          "then": {"required": ["query"]},
          "else": {"not": {"required": ["query"]}}
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "repository", "branch", "commit",
        "agent_id", "invocation_attestation_sha256", "requested_permission_class",
        "requested_tools", "operations", "authorization", "request_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "agent_execution_request"},
        "repository": {"const": "https://github.com/The-Architect-369/Arcanum.git"},
        "branch": {"const": "mobile"},
        "commit": {"$ref": "#/$defs/sha40"},
        "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "invocation_attestation_sha256": {"$ref": "#/$defs/sha64"},
        "requested_permission_class": {"enum": ["R0", "R1"]},
        "requested_tools": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["repository.read", "repository.search"]}
        },
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
        "authorization": {"const": "explicit_human_request"},
        "request_sha256": {"$ref": "#/$defs/sha64"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "repository", "branch", "commit",
        "agent_id", "requested_permission_class", "requested_tools",
        "invocation_attestation_sha256", "execution_request_sha256", "status",
        "mode", "tools_executed", "external_writes_performed",
        "repository_mutation_performed", "merge_performed", "deploy_performed",
        "operations", "preservation", "authority", "attestation_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "record_type": {"const": "agent_execution_attestation"},
        "repository": {"const": "https://github.com/The-Architect-369/Arcanum.git"},
        "branch": {"const": "mobile"},
        "commit": {"$ref": "#/$defs/sha40"},
        "agent_id": {"type": "string"},
        "requested_permission_class": {"enum": ["R0", "R1"]},
        "requested_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "invocation_attestation_sha256": {"$ref": "#/$defs/sha64"},
        "execution_request_sha256": {"$ref": "#/$defs/sha64"},
        "status": {"const": "completed"},
        "mode": {"const": "read_only"},
        "tools_executed": {"const": true},
        "external_writes_performed": {"const": false},
        "repository_mutation_performed": {"const": false},
        "merge_performed": {"const": false},
        "deploy_performed": {"const": false},
        "operations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "preservation": {"type": "object"},
        "authority": {"const": "read_only_agent_execution"},
        "attestation_sha256": {"$ref": "#/$defs/sha64"}
      }
    }
  }
}
