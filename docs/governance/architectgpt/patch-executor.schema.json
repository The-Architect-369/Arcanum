{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/architectgpt/patch-executor.schema.json",
  "title": "Architect GPT Isolated Patch Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "repository",
    "base_commit",
    "target_branch",
    "permission_class",
    "bundle_sha256",
    "status",
    "declared_changes",
    "observed_status",
    "verification",
    "candidate_diff_sha256",
    "source_checkout_unchanged",
    "authority",
    "attestation_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "isolated_patch_attestation"},
    "repository": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_branch": {"const": "mobile"},
    "permission_class": {"enum": ["W1", "W2", "W3", "C1"]},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "pass"},
    "declared_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "path"],
        "properties": {
          "action": {"enum": ["create", "update", "delete", "rename"]},
          "path": {"type": "string", "minLength": 1},
          "from_path": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "observed_status": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "output_sha256", "status"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"const": 0},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"const": "pass"}
        }
      }
    },
    "candidate_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_checkout_unchanged": {"const": true},
    "authority": {"const": "evidentiary_only"},
    "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
