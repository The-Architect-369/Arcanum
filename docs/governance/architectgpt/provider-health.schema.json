{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/provider-health.snapshot.v2.json",
  "title": "Arcanum Provider Health Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "observed_at",
    "repository",
    "commit",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "record_type": {
      "const": "provider_health_snapshot"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "manifest_status"
        ],
        "properties": {
          "status": {
            "enum": [
              "healthy",
              "degraded",
              "unavailable",
              "unverified"
            ]
          },
          "manifest_status": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
