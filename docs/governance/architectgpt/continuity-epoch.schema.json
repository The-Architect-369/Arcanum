{
  "$id": "https://the-arcanum.net/schemas/architectgpt/continuity-epoch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_epoch": {
      "additionalProperties": false,
      "properties": {
        "controlling_log": {
          "const": "docs/governance/architectgpt/architect-log.md"
        },
        "epoch_id": {
          "const": "ARC-CONT-EPOCH-2"
        },
        "first_session_number": {
          "minimum": 1,
          "type": "integer"
        },
        "predecessor_ids_never_reused": {
          "const": true
        },
        "session_ledger": {
          "const": "docs/governance/architectgpt/sessions"
        },
        "starts_after_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "status": {
          "const": "ACTIVE"
        }
      },
      "required": [
        "epoch_id",
        "status",
        "starts_after_commit",
        "first_session_number",
        "controlling_log",
        "session_ledger",
        "predecessor_ids_never_reused"
      ],
      "type": "object"
    },
    "authority": {
      "const": "continuity-metadata-only"
    },
    "record_type": {
      "const": "continuity-epoch-seal"
    },
    "schema": {
      "const": "arcanum.architect.continuity-epoch/v1"
    },
    "sealed_epoch": {
      "additionalProperties": false,
      "properties": {
        "controlling_log": {
          "additionalProperties": false,
          "properties": {
            "git_blob_sha": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "path": {
              "const": "docs/governance/architectgpt/architect-log.md"
            }
          },
          "required": [
            "path",
            "git_blob_sha"
          ],
          "type": "object"
        },
        "epoch_id": {
          "const": "ARC-CONT-EPOCH-1"
        },
        "reserved_session_ids": {
          "items": {
            "pattern": "^ARC-SES-[1-9][0-9]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "const": "pre-baseline-developmental-continuity"
        },
        "sealed_through_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "session_records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "git_blob_sha": {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              "path": {
                "pattern": "^docs/governance/architectgpt/sessions/.+\\.md$",
                "type": "string"
              },
              "session_id": {
                "pattern": "^ARC-SES-[1-9][0-9]*$",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "path",
              "git_blob_sha"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "status": {
          "const": "SEALED"
        }
      },
      "required": [
        "epoch_id",
        "status",
        "scope",
        "sealed_through_commit",
        "controlling_log",
        "reserved_session_ids",
        "session_records"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "record_type",
    "authority",
    "sealed_epoch",
    "active_epoch"
  ],
  "title": "Architect GPT Continuity Epoch Seal",
  "type": "object"
}
