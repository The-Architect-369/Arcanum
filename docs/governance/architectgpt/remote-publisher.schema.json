{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/The-Architect-369/Arcanum/docs/governance/architectgpt/remote-publisher.schema.json",
  "title": "Architect GPT Guarded Remote Ref Publisher Records",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/attestation" }
  ],
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "repository",
        "remote",
        "target_ref",
        "expected_remote_commit",
        "candidate_commit_sha",
        "local_publication_attestation_sha256",
        "permission_class",
        "authorization",
        "summary",
        "request_sha256"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "remote_ref_publication_request" },
        "repository": { "type": "string", "minLength": 1 },
        "remote": { "const": "origin" },
        "target_ref": { "const": "refs/heads/mobile" },
        "expected_remote_commit": { "$ref": "#/$defs/sha40" },
        "candidate_commit_sha": { "$ref": "#/$defs/sha40" },
        "local_publication_attestation_sha256": { "$ref": "#/$defs/sha64" },
        "permission_class": { "const": "W2" },
        "authorization": { "const": "explicit_human_request" },
        "summary": { "type": "string", "minLength": 1 },
        "request_sha256": { "$ref": "#/$defs/sha64" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "repository",
        "remote",
        "target_ref",
        "expected_old_commit",
        "candidate_commit_sha",
        "local_publication_attestation_sha256",
        "remote_publication_request_sha256",
        "mode",
        "status",
        "remote_ref_updated",
        "tracking_ref_updated",
        "main_updated",
        "tag_updated",
        "merge_performed",
        "deploy_performed",
        "push_output_sha256",
        "authority",
        "attestation_sha256"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "record_type": { "const": "remote_ref_publication_attestation" },
        "repository": { "type": "string", "minLength": 1 },
        "remote": { "const": "origin" },
        "target_ref": { "const": "refs/heads/mobile" },
        "expected_old_commit": { "$ref": "#/$defs/sha40" },
        "candidate_commit_sha": { "$ref": "#/$defs/sha40" },
        "local_publication_attestation_sha256": { "$ref": "#/$defs/sha64" },
        "remote_publication_request_sha256": { "$ref": "#/$defs/sha64" },
        "mode": { "enum": ["dry_run", "apply"] },
        "status": { "enum": ["ready", "applied"] },
        "remote_ref_updated": { "type": "boolean" },
        "tracking_ref_updated": { "type": "boolean" },
        "main_updated": { "const": false },
        "tag_updated": { "const": false },
        "merge_performed": { "const": false },
        "deploy_performed": { "const": false },
        "push_output_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha64" }
          ]
        },
        "authority": {
          "enum": ["evidentiary_only", "remote_integration_ref_write_only"]
        },
        "attestation_sha256": { "$ref": "#/$defs/sha64" }
      }
    }
  }
}
