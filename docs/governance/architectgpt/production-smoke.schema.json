{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/architectgpt/production-smoke.schema.json",
  "title": "Architect GPT Production Smoke Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "observed_at",
    "repository",
    "commit",
    "deployment",
    "base_url",
    "manifest_sha256",
    "request_sha256",
    "preflight",
    "routes",
    "summary",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "production_smoke_attestation"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "The-Architect-369/Arcanum"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "deployment_id",
        "state",
        "target",
        "commit",
        "url"
      ],
      "properties": {
        "provider": {
          "const": "vercel"
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "READY"
        },
        "target": {
          "enum": [
            "production",
            "preview"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base_url": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "routes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "path",
          "expected_status",
          "observed_status",
          "redirect_count",
          "duration_ms",
          "response_bytes",
          "markers",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "GET",
              "HEAD"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "expected_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "observed_status": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "redirect_count": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "response_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "markers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "present"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "present": {
                  "type": "boolean"
                }
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "classification",
        "observed_status",
        "final_url",
        "duration_ms",
        "error"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "classification": {
          "enum": [
            "publicly_accessible",
            "provider_access_protected",
            "cross_host_redirect",
            "transport_error"
          ]
        },
        "observed_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "final_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
