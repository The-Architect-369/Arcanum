{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-arcanum.net/schemas/merge-authorization.schema.json",
  "title": "Architect GPT Merge Authorization Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "repository",
    "pull_request_number",
    "base_branch",
    "head_branch",
    "expected_head_sha",
    "merge_method",
    "promotion_attestation_sha256",
    "ci_attestation_sha256",
    "provider_evidence_sha256",
    "merge_request_sha256",
    "permission_class",
    "authorization",
    "status",
    "merge_performed",
    "deploy_performed",
    "authority",
    "package_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "merge_authorization_package"},
    "repository": {"const": "https://github.com/The-Architect-369/Arcanum.git"},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "base_branch": {"const": "main"},
    "head_branch": {"const": "mobile"},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_method": {"const": "merge"},
    "promotion_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ci_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "merge_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permission_class": {"const": "W3"},
    "authorization": {"const": "explicit_human_request"},
    "status": {"const": "authorized"},
    "merge_performed": {"const": false},
    "deploy_performed": {"const": false},
    "authority": {"const": "merge_authorization_evidence_only"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
