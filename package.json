{
  "name": "arcanum",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "sync:architect": "bash scripts/sync-architect.sh",
    "verify:architect": "bash scripts/verify-architect.sh",
    "verify:repo-index": "bash scripts/verify-repo-index.sh",
    "verify:construction-docs": "python3 scripts/verify-construction-docs.py",
    "verify:ce-w01": "python3 scripts/verify-ce-w01.py",
    "verify:ce-w02:integrated": "python3 scripts/verify-ce-w02-integrated.py",
    "verify:ce-w03": "pnpm verify:ce-w02:integrated && python3 scripts/verify-ce-w03.py && python3 scripts/verify-ce-w03-reflection.py"
  },
  "packageManager": "pnpm@9.10.0"
}
