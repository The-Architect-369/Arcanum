# Configure securely in the hosting provider; never commit real client secrets.
AUTH_URL=https://architect.the-arcanum.net
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ARCHITECT_GOOGLE_EMAIL=the-architect@the-arcanum.net

# Architect portal: store stays outside the repository/public assets. No default enrollment.
ARCHITECT_STORE_PATH=
# Serverless alternative: approved authenticated HTTPS snapshot+enrollment transport.
ARCHITECT_STORE_URL=
ARCHITECT_STORE_TOKEN=
# Preview opt-in must equal AUTH_URL and Vercel's trusted VERCEL_BRANCH_URL origin.
ARCHITECT_PREVIEW_ORIGIN=
