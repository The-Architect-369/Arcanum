<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="ARCnet Native Host"
        android:networkSecurityConfig="@xml/architect_loopback_network_security"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service
            android:name=".architect.TermuxOperatorResultService"
            android:exported="false" />
        <provider
            android:name=".architect.ArchitectObservationProvider"
            android:authorities="${applicationId}.architect.observation"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
